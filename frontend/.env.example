VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# AI classification/briefing always goes through the backend proxy (see
# backend/.env.example), which holds the Anthropic/Groq API keys server-side.
# The browser never calls those APIs directly. Leave this blank to always use
# the deterministic heuristic fallback instead of AI.
VITE_BACKEND_API_BASE_URL=

# Super admin emails only (top of the officer hierarchy - full access,
# manages the officer roster). Senior/junior officers are NOT listed here -
# add them from the in-app "Manage Officers" screen (Super Admin only) so new
# officers can be added without a redeploy.
VITE_ADMIN_EMAILS=admin@example.com

# bhopal (default, real ward/zone GIS data) or sati-vidisha (legacy demo)
VITE_DEFAULT_REGION_ID=bhopal
VITE_PROTOTYPE_MODE=true

# No key needed: reverse geocoding uses OpenStreetMap Nominatim.
