# Primary AI provider.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-5

# Silent backup provider - only used if the Anthropic call fails. Never
# exposed to the frontend; this key stays server-side only.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Set to the exact deployed frontend URL once known (e.g. https://your-app.vercel.app).
# Defaults to * for local development only - MUST be locked down before
# going live, otherwise any website can call these endpoints on your bill.
ALLOWED_ORIGIN=*
